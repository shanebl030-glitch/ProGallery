<?xml version="1.0" encoding="utf-8"?>
<!-- Settings and the hidden-album list are device-local and must not be cloud-backed-up
     or transferred (a hidden album list leaking to another device defeats its purpose). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
