<?xml version="1.0" encoding="utf-8"?>
<!-- ProGallery adaptive icon foreground: a photo card (sunset sky, mountains, sun) over a
     tilted second card, with a play badge for video. All artwork sits inside the 66dp
     safe zone so no launcher mask crops it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="57.5"
        android:pivotY="57.5"
        android:scaleX="0.9"
        android:scaleY="0.9"
        android:translateX="-3.5"
        android:translateY="-3.5">
        <!-- Back card (tilted) -->
        <path
            android:fillColor="#FFFFFFFF"
            android:fillAlpha="0.38"
            android:pathData="M35.6,38.1 L68.9,32.2 A5,5 0 0 1 74.7,36.3 L78.4,57.3 A5,5 0 0 1 74.3,63.1 L41,69 A5,5 0 0 1 35.2,64.9 L31.5,43.9 A5,5 0 0 1 35.6,38.1 Z" />
        <!-- Front card -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M36,40 H70 A6,6 0 0 1 76,46 V70 A6,6 0 0 1 70,76 H36 A6,6 0 0 1 30,70 V46 A6,6 0 0 1 36,40 Z" />
        <!-- Photo window: sunset sky -->
        <path android:pathData="M37,44 H69 A3,3 0 0 1 72,47 V69 A3,3 0 0 1 69,72 H37 A3,3 0 0 1 34,69 V47 A3,3 0 0 1 37,44 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="0" android:startY="40"
                    android:endX="0" android:endY="70">
                    <item android:offset="0" android:color="#FFFDBA74" />
                    <item android:offset="1" android:color="#FFF472B6" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- Sun -->
        <path
            android:fillColor="#FFFFF7ED"
            android:pathData="M61,52.5 m-4,0 a4,4 0 1 1 8,0 a4,4 0 1 1 -8,0" />
        <!-- Mountains -->
        <path
            android:fillColor="#FF4338CA"
            android:pathData="M34,64 L45,53 L53,61 L57,57 L72,69 V69 A3,3 0 0 1 69,72 H37 A3,3 0 0 1 34,69 Z" />
        <path
            android:fillColor="#FF312E81"
            android:pathData="M34,67 L42,61 L52,72 H37 A3,3 0 0 1 34,69 Z" />
        <!-- Play badge -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M75,73 m-10,0 a10,10 0 1 1 20,0 a10,10 0 1 1 -20,0" />
        <path
            android:fillColor="#FF6D28D9"
            android:pathData="M72,68.2 L80.4,73 L72,77.8 Z" />
    </group>
</vector>
